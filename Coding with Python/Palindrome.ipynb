    "#Palindrome\n",
    "def Palindrome(S):\n",
    "    if(S==S[::-1]):\n",
    "        return True\n",
    "    else:\n",
    "        return False\n",
    "print(Palindrome(\"ABBA\")) #It will return True\n",
    "print(Palindrome(\"ABDA\")) #It will return False"
   ]
